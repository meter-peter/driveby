{
  "openapi": "3.1.0",
  "info": {
    "title": "Nullable Test API",
    "version": "1.0.0",
    "description": "API with OpenAPI 3.1.0 nullable anyOf patterns"
  },
  "paths": {
    "/items": {
      "get": {
        "operationId": "listItems",
        "summary": "List items",
        "description": "Returns items with nullable fields",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Item"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Item": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "anyOf": [
              {"type": "string"},
              {"type": "null"}
            ],
            "title": "Description",
            "description": "Optional item description"
          },
          "count": {
            "anyOf": [
              {"type": "integer", "minimum": 0},
              {"type": "null"}
            ],
            "title": "Count"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
