{
  "openapi": "3.0.3",
  "info": {
    "title": "Auth Required API",
    "version": "1.0.0",
    "description": "API with security requirements and 401 responses"
  },
  "security": [
    {"ApiKeyAuth": []}
  ],
  "paths": {
    "/public/health": {
      "get": {
        "operationId": "healthCheck",
        "summary": "Health check",
        "description": "Public health check endpoint",
        "security": [],
        "responses": {
          "200": {
            "description": "Healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/protected/data": {
      "get": {
        "operationId": "getProtectedData",
        "summary": "Get protected data",
        "description": "Requires API key authentication",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {
                    "data": {"type": "string"}
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "example": {
                  "error": "Authentication required",
                  "code": 401
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createProtectedData",
        "summary": "Create protected data",
        "description": "Requires API key authentication",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": {"type": "string"},
                  "value": {"type": "integer"}
                }
              },
              "example": {
                "name": "test",
                "value": 42
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id", "name"],
                  "properties": {
                    "id": {"type": "string"},
                    "name": {"type": "string"},
                    "value": {"type": "integer"}
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "API key authentication"
      }
    }
  }
}
