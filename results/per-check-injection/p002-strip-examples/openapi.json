              "type": "string"
            },
            "type": "array",
            "title": "Tags",
            "description": "Tags associated with the product",
            "default": []
          },
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Unique identifier for the product"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At",
            "description": "Date and time when the product was created"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At",
            "description": "Date and time when the product was last updated"
          }
        },
        "type": "object",
        "required": [
          "name",
          "description",
          "price",
          "category",
